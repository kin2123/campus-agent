# ============================================================================
# 校园课程智能助手 · 环境配置
# 复制为 .env 后按需修改。不改也能跑（全部有默认值）。
# ============================================================================

# ---------- 服务端口 ----------
# 刻意避开 8000/8080：容易与已有服务冲突，且某些环境会注入 SERVER_PORT
HOST=127.0.0.1
BACKEND_PORT=18000
MCP_PORT=18001

# ---------- 鉴权 ----------
# 生产环境务必改成随机长字符串
JWT_SECRET=campus-assistant-dev-secret-change-me
ACCESS_TOKEN_MINUTES=720
MCP_TICKET_SECONDS=300

# ---------- 模型接入 ----------
# fake                = 内置脚本假模型，无需 API Key，用于验证链路
# deepseek            = 需要 LLM_API_KEY
# zhipu               = 需要 LLM_API_KEY（智谱 GLM）
# openai_compatible   = 需要 LLM_API_KEY + LLM_BASE_URL + LLM_MODEL
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.0

# ---------- RAG ----------
# local = 内置字符 n-gram 哈希向量，零 Key 开箱可用
# 接入真实 embedding 后改为 openai_compatible 并填 EMBEDDING_MODEL
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=
CHROMA_COLLECTION=campus_knowledge
RAG_TOP_K=4

# ---------- 业务规则 ----------
MAX_CREDITS_PER_SEMESTER=30
